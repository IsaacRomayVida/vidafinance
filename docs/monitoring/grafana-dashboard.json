{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Service Health",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"vida-.*\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (service) (rate(vida_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Latency p95 (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(vida_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (service) (rate(vida_http_request_duration_seconds_count{status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Business Events",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (event) (rate(vida_business_events_total[5m]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "External Provider Latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(vida_external_provider_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider Error Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(vida_external_provider_duration_seconds_count{outcome=\"error\"}[5m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "vida_queue_depth",
          "legendFormat": "{{queue}} [{{state}}]",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node Memory (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "vida_process_resident_memory_bytes",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Loans Disbursed (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "sum(increase(vida_business_events_total{event=\"loan_disbursed\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Disbursement Failures (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 36 },
      "targets": [
        {
          "expr": "sum(increase(vida_business_events_total{event=\"disbursement_failed\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Loans Repaid (24h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 36 },
      "targets": [
        {
          "expr": "sum(increase(vida_business_events_total{event=\"loan_repaid\"}[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active Circuit Breakers",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 36 },
      "targets": [
        {
          "expr": "sum(vida_circuit_breaker_state > 0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ML Predictions / min by Decision",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "sum by (decision) (rate(ml_predictions_total[5m])) * 60",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 15, "stacking": { "mode": "normal" } },
          "unit": "reqpm"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ML Prediction Latency (p50 / p95 / p99)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ml_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ml_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ml_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s"
        }
      }
    },
    {
      "type": "stat",
      "title": "ML Model Version",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "targets": [
        {
          "expr": "ml_model_info",
          "legendFormat": "champion={{champion}} challenger={{challenger}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "Active", "color": "green" } } }
          ]
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vida", "launch"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "America/Mexico_City",
  "title": "VIDA Platform — v1.8 Monitoring",
  "uid": "vida-platform-monitoring",
  "version": 1,
  "weekStart": ""
}

