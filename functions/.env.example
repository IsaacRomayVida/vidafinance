# Cloud Function runtime environment variables
# Copy this file to .env and fill in the values
SOFTCREDITO_ADAPTER_URL=
PDF_GENERATOR_URL=
INTERNAL_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
# From address for outbound email (use a Funpay-domain sender, e.g. noreply@funpay.mx)
SENDGRID_FROM_EMAIL=
# Internal inbox that receives contact-form submissions (onContactCreated trigger)
CONTACT_NOTIFY_EMAIL=hola@funpay.mx
METAMAP_CLIENT_ID=
METAMAP_CLIENT_SECRET=
METAMAP_FLOW_ID_KYC=
RISKSEAL_API_URL=
RISKSEAL_API_KEY=
PAYMENT_SERVER_URL=https://payment-server-production-b9b8.up.railway.app
SLACK_WEBHOOK_URL=

# Sentry error telemetry (optional — Sentry is disabled when unset)
# Get DSN from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# Optional: stamp crash reports with the deployed commit SHA
SENTRY_RELEASE=
