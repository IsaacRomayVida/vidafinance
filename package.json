{
  "scripts": {
    "verify": "node scripts/verify-production.js",
    "test": "jest",
    "test:rules": "jest firestore.rules.test",
    "test:integration": "jest --config tests/integration/jest.config.js && cd services/ml-service && python3 -m pytest ../../tests/integration/test_decision_paths.py -v",
    "test:integration:js": "jest --config tests/integration/jest.config.js",
    "test:integration:py": "cd services/ml-service && python3 -m pytest ../../tests/integration/test_decision_paths.py -v",
    "prepare": "husky"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "commonjs",
          "esModuleInterop": true,
          "strict": true,
          "skipLibCheck": true,
          "target": "es2020"
        }
      }
    }
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/jest": "^30.0.0",
    "firebase": "^12.10.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "functions/src/**/*.ts": [
      "eslint --fix --max-warnings 0",
      "tsc --noEmit -p functions/tsconfig.json"
    ],
    "services/**/*.ts": [
      "eslint --fix --max-warnings 0"
    ],
    "services/ml-service/**/*.py": [
      "python -m black --check",
      "python -m flake8"
    ]
  }
}
