{
  "scripts": {
    "verify": "node scripts/verify-production.js",
    "test": "jest",
    "test:rules": "jest \"(firestore|storage)\\.rules\\.test\"",
    "test:migrations": "jest --roots scripts/migrations",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "load-test": "k6 run tests/load/pipeline-load-test.js",
    "load-test:smoke": "k6 run --env PROFILE=smoke tests/load/pipeline-load-test.js",
    "load-test:full": "k6 run --out json=tests/load/results/results.json tests/load/pipeline-load-test.js",
    "load-test:report": "node tests/load/generate-report.js",
    "test:e2e": "jest --config tests/e2e/jest.config.js",
    "test:e2e:loan-flow": "jest --config tests/e2e/jest.emulator.config.js",
    "prepare": "husky"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "commonjs",
          "esModuleInterop": true,
          "strict": true,
          "skipLibCheck": true,
          "target": "es2020"
        }
      }
    }
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "eslint": "^10.2.0",
    "node-fetch": "^2.7.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/jest": "^30.0.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.4.0",
    "puppeteer": "^24.40.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "functions/src/**/*.ts": [
      "eslint --fix --max-warnings 0",
      "bash -c 'cd functions && tsc --noEmit'"
    ],
    "services/**/*.ts": [
      "eslint --fix --max-warnings 0"
    ],
    "services/ml-service/**/*.py": [
      "bash services/ml-service/scripts/precommit_lint.sh black",
      "bash services/ml-service/scripts/precommit_lint.sh flake8"
    ]
  }
}
