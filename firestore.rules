rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function hasRole(role) {
      return request.auth.token.role == role;
    }
    function isAdmin() {
      // Support both legacy token.admin boolean and new role-based claims
      return hasRole('admin') || hasRole('super_admin') || request.auth.token.admin == true;
    }
    function isOps() {
      return hasRole('ops') || isAdmin();
    }

    // =============================================
    // EMPLOYERS COLLECTION
    // Employers can read/update their own record (limited fields).
    // Authenticated users can self-register as employers (onboarding).
    // Only admins can promote employer status.
    // =============================================
    match /employers/{employerId} {
      allow read: if isOwner(employerId) || isOps();
      allow create: if isAdmin()
        || (isAuthenticated() && isOwner(employerId)
          && request.resource.data.keys().hasAll(['name', 'companyName', 'email', 'employerCode', 'status', 'createdAt'])
          && request.resource.data.status == 'pending_verification');
      allow update: if isAdmin()
        || (isOwner(employerId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'email', 'phone', 'contactName', 'contactEmail', 'contactPhone']));
      allow delete: if false;
    }

    // =============================================
    // EMPLOYEES COLLECTION
    // Employees can read/update their own record (limited fields).
    // Employers can read their own employees (via employerId match).
    // Authenticated users can self-register as employees (onboarding).
    // =============================================
    match /employees/{employeeId} {
      allow read: if isOwner(employeeId)
                  || (isAuthenticated() && resource.data.employerId == request.auth.uid)
                  || isOps();
      allow create: if isOps()
        || (isAuthenticated() && isOwner(employeeId)
          && request.resource.data.keys().hasAll(['name', 'email', 'employerId', 'employerName', 'monthlySalary', 'creditLimit', 'availableCredit', 'createdAt'])
          && request.resource.data.employerId is string
          && request.resource.data.monthlySalary is number
          && request.resource.data.creditLimit is number);
      allow update: if isOps()
        || (isOwner(employeeId)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['bankClabe', 'bankName', 'phone', 'address']));
      allow delete: if false;
    }

    // =============================================
    // LOANS COLLECTION
    // Employees can read their own loans; employers can read loans under them.
    // ALL writes are Cloud Function only (Admin SDK bypasses rules).
    // Client SDK can NEVER create or modify loans.
    // =============================================
    match /loans/{loanId} {
      allow read: if isAuthenticated() && (
        resource.data.employeeId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isOps()
      );
      allow create: if false;  // Only Cloud Functions via Admin SDK
      allow update: if false;  // Only Cloud Functions via Admin SDK
      allow delete: if false;  // Loans are never deleted, only marked
    }

    // =============================================
    // CONTACTS — PUBLIC SUBMIT (validated), ADMIN READ/MANAGE
    // Collection name: 'contacts' (plural) to match client code.
    // =============================================
    match /contacts/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'email', 'type', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'type', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // =============================================
    // REPAYMENTS — EMPLOYEE + ADMIN READ, IMMUTABLE
    // =============================================
    match /repayments/{d} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if false;
    }

    // =============================================
    // AUDIT & OPERATIONAL LOGS — ADMIN READ, IMMUTABLE
    // All writes go through Cloud Functions (Admin SDK).
    // =============================================
    match /auditLogs/{docId}          { allow read: if isAdmin();  allow write: if false; }
    match /overdue_log/{d}           { allow read: if isAdmin();  allow write: if false; }
    match /spei_log/{d}              { allow read: if isAdmin();  allow write: if false; }
    match /payment_failures/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /incident_log/{d}          { allow read: if isAdmin();  allow write: if false; }
    match /notification_log/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /softcredito_employers/{d} { allow read: if isAdmin();  allow write: if false; }
    match /ml_decisions/{d}          { allow read: if isAdmin();  allow write: if false; }

    // =============================================
    // OPS-READABLE OPERATIONAL COLLECTIONS
    // =============================================
    match /scheduler_runs/{d}        { allow read: if isOps();    allow write: if false; }
    match /portfolio_snapshots/{d}   { allow read: if isOps();    allow write: if false; }
    match /system_health/{d}         { allow read: if isOps();    allow write: if false; }

    // =============================================
    // INTERNAL QUEUES — DENY ALL CLIENT ACCESS
    // Only accessed by Cloud Functions via Admin SDK.
    // =============================================
    match /disbursement_queue/{d}    { allow read, write: if false; }
    match /notification_queue/{d}    { allow read, write: if false; }

    // =============================================
    // DENY ALL OTHER PATHS
    // Explicit catch-all to prevent accidental access.
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
