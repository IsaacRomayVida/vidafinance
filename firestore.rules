rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin') || (isAuthenticated() && request.auth.token.admin == true);
    }
    function isOps() {
      return hasRole('ops') || isAdmin();
    }
    // An employer_admin's uid is the employer doc id; the employerId claim is
    // a fallback for the case where the two diverge (set by setClaims CF).
    function isEmployerAdminOf(employerId) {
      return isAuthenticated() && (
        request.auth.uid == employerId ||
        request.auth.token.employerId == employerId
      );
    }
    // Only touching these fields is a no-op update — allow self-updates that don't modify them.
    function onlyAffects(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // =============================================
    // USERS COLLECTION
    // Owner or admin can read their profile. All writes via Admin SDK (setClaims CF).
    // =============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // =============================================
    // EMPLOYERS COLLECTION
    // Get: the employer's own admin or ops. (Employee onboarding uses
    //   list+where('employerCode') — single-doc get by id is not used cross-tenant.)
    // List: left open for the unauthenticated employerCode lookup during
    //   onboarding (Onboarding.tsx). The document reveals only public company
    //   info (name, logo). Tightening requires moving lookup into a CF — follow-up.
    // Create: user bootstrapping their own employer doc during onboarding, or admin.
    // Update: admin (any field), or own admin (whitelisted contact fields only).
    // Delete: ops only.
    // =============================================
    match /employers/{employerId} {
      allow get: if isEmployerAdminOf(employerId) || isOps();
      allow list: if true;
      allow create: if isAdmin() || isOwner(employerId);
      allow update: if isAdmin()
                    || (isEmployerAdminOf(employerId)
                        && onlyAffects(['contactName', 'contactEmail', 'contactPhone', 'logoUrl', 'updatedAt']));
      allow delete: if isOps();
    }

    // =============================================
    // EMPLOYEES COLLECTION (flat /employees/{uid})
    // Read: the employee themselves, the employer_admin of their employer, or ops.
    //   This is the core isolation: employee A cannot read employee B even in
    //   the same employer, and employer A cannot read employer B's employees.
    // Create: self-registration during onboarding (uid == employeeId).
    // Update: ops (any field), or self (whitelisted personal fields only) —
    //   creditLimit, availableCredit, employerId, kycStatus must come from CFs.
    // Delete: ops only.
    // =============================================
    match /employees/{employeeId} {
      allow read: if isOwner(employeeId)
                  || (resource != null && isEmployerAdminOf(resource.data.employerId))
                  || isOps();
      allow create: if isOwner(employeeId);
      allow update: if isOps()
                    || (isOwner(employeeId)
                        && onlyAffects(['phone', 'bankClabe', 'bankName', 'address',
                                        'dateOfBirth', 'gender', 'updatedAt']));
      allow delete: if isOps();
    }

    // =============================================
    // EMPLOYEES SUBCOLLECTION (/employers/{employerId}/employees/{employeeDocId})
    // Used by the invite flow (sendEmployeeInvite CF). All writes via Admin SDK.
    // Read: the employer_admin of that employer, or ops.
    // =============================================
    match /employers/{employerId}/employees/{employeeDocId} {
      allow read: if isEmployerAdminOf(employerId) || isOps();
      allow write: if false;
    }

    // =============================================
    // LOANS COLLECTION
    // Read: the loan's employee, its employer_admin, or ops.
    // All writes via Admin SDK (requestLoan / markLoanDisbursed / etc.).
    // =============================================
    match /loans/{loanId} {
      allow read: if resource != null && (
                    isOwner(resource.data.employeeId) ||
                    isEmployerAdminOf(resource.data.employerId) ||
                    isOps()
                  );
      allow create, update: if false;
      allow delete: if isOps();
    }

    // =============================================
    // INVITES COLLECTION (VID3-672)
    // All access via Admin SDK: sendEmployeeInvite / lookupInvite / acceptInvite CFs.
    // The lookupInvite CF accepts the raw token and hashes it server-side,
    // so clients never need to read these documents directly.
    // =============================================
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // =============================================
    // WEBHOOK EVENTS (VID3-657) — MetaMap webhook handler
    // Admin SDK only — written by the webhook Cloud Function, read by ops via CF.
    // =============================================
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // =============================================
    // CONTACT — PUBLIC SUBMIT (validated), ADMIN READ/MANAGE
    // Public marketing forms (coming-soon page + /contact) write here directly.
    // Validation keeps create open but bounds the shape to curb spam/abuse.
    // =============================================
    match /contact/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'type', 'message', 'company', 'phone', 'source', 'lang', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // =============================================
    // REPAYMENTS — EMPLOYEE + ADMIN READ, IMMUTABLE
    // =============================================
    match /repayments/{d} {
      allow read: if isAdmin()
                  || (resource != null && isOwner(resource.data.employeeId));
      allow write: if false;
    }

    // =============================================
    // REVIEW QUEUE — OPS-ONLY READ, WRITES VIA CLOUD FUNCTIONS
    // =============================================
    match /review_queue/{docId} {
      allow read: if isOps();
      allow write: if false;
    }

    // =============================================
    // AUDIT & OPERATIONAL LOGS — OPS/ADMIN-ONLY READ, IMMUTABLE
    // All writes go through Cloud Functions (Admin SDK).
    // =============================================
    match /audit_log/{docId}         { allow read: if isOps();    allow write: if false; }
    match /overdue_log/{d}           { allow read: if isAdmin();  allow write: if false; }
    match /spei_log/{d}              { allow read: if isAdmin();  allow write: if false; }
    match /payment_failures/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /incident_log/{d}          { allow read: if isAdmin();  allow write: if false; }
    match /notification_log/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /softcredito_employers/{d} { allow read: if isAdmin();  allow write: if false; }
    match /ml_decisions/{d}          { allow read: if isOps();    allow write: if false; }

    // =============================================
    // OPS-READABLE OPERATIONAL COLLECTIONS
    // =============================================
    match /scheduler_runs/{d}        { allow read: if isOps();    allow write: if false; }
    match /portfolio_snapshots/{d}   { allow read: if isOps();    allow write: if false; }
    match /system_health/{d}         { allow read: if true;       allow write: if false; }

    // =============================================
    // INTERNAL QUEUES — DENY ALL CLIENT ACCESS
    // Only accessed by Cloud Functions via Admin SDK.
    // =============================================
    match /disbursement_queue/{d}    { allow read, write: if false; }
    match /notification_queue/{d}    { allow read, write: if false; }
    match /metamap_shadow_log/{d}    { allow read, write: if false; }

    // =============================================
    // DENY ALL OTHER PATHS
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
