rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function hasRole(role) {
      return request.auth.token.role == role;
    }
    function isAdmin() {
      // Support both legacy token.admin boolean and new role-based claims
      return hasRole('admin') || hasRole('super_admin') || request.auth.token.admin == true;
    }
    function isOps() {
      return hasRole('ops') || isAdmin();
    }

    // =============================================
    // USERS COLLECTION
    // Users can read their own profile (role, email, etc.).
    // All writes go through Cloud Functions (Admin SDK).
    // =============================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // =============================================
    // EMPLOYERS COLLECTION
    // Employers can read/update their own record (limited fields).
    // Users can create their own employer record during onboarding.
    // Only admins can create records for other users.
    // =============================================
    match /employers/{employerId} {
      // Allow list queries for employer code lookup during employee onboarding
      allow list: if true;
      allow get: if isOwner(employerId) || isOps();
      allow create: if isAdmin() || isOwner(employerId);
      allow update: if isAdmin() || isOwner(employerId);
      allow delete: if isOps();
    }

    // =============================================
    // EMPLOYEES COLLECTION
    // Employees can read/update their own record (limited fields).
    // Employers can read their own employees (via employerId match).
    // Authenticated users can create their own employee record (self-registration).
    // =============================================
    match /employees/{employeeId} {
      allow read: if isOwner(employeeId)
                  || (isAuthenticated() && resource.data.employerId == request.auth.uid)
                  || isOps();
      allow create: if request.auth != null && request.auth.uid == employeeId;
      allow update: if isOps() || isOwner(employeeId);
      allow delete: if isOps();
    }

    // =============================================
    // LOANS COLLECTION
    // Employees can read their own loans; employers can read loans under them.
    // ALL writes are Cloud Function only (Admin SDK bypasses rules).
    // Client SDK can NEVER create or modify loans.
    // =============================================
    match /loans/{loanId} {
      allow read: if isAuthenticated() && (
        resource.data.employeeId == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        isOps()
      );
      allow create: if false;  // Only Cloud Functions via Admin SDK
      allow update: if false;  // Only Cloud Functions via Admin SDK
      allow delete: if isOps();  // Ops can delete test data
    }

    // =============================================
    // CONTACT — PUBLIC SUBMIT, ADMIN READ/MANAGE
    // =============================================
    match /contact/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // =============================================
    // REPAYMENTS — EMPLOYEE + ADMIN READ, IMMUTABLE
    // =============================================
    match /repayments/{d} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow write: if false;
    }

    // =============================================
    // REVIEW QUEUE — ADMIN-ONLY READ, WRITES VIA CLOUD FUNCTIONS
    // =============================================
    match /review_queue/{docId} {
      allow read: if isAdmin();
      allow write: if false;  // Only Cloud Functions via Admin SDK
    }

    // =============================================
    // AUDIT & OPERATIONAL LOGS — ADMIN-ONLY READ, IMMUTABLE
    // All writes go through Cloud Functions (Admin SDK).
    // =============================================
    match /audit_log/{docId}         { allow read: if isAdmin();  allow write: if false; }
    match /overdue_log/{d}           { allow read: if isAdmin();  allow write: if false; }
    match /spei_log/{d}              { allow read: if isAdmin();  allow write: if false; }
    match /payment_failures/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /incident_log/{d}          { allow read: if isAdmin();  allow write: if false; }
    match /notification_log/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /softcredito_employers/{d} { allow read: if isAdmin();  allow write: if false; }
    match /ml_decisions/{d}          { allow read: if isAdmin();  allow write: if false; }

    // =============================================
    // OPS-READABLE OPERATIONAL COLLECTIONS
    // =============================================
    match /scheduler_runs/{d}        { allow read: if isOps();    allow write: if false; }
    match /portfolio_snapshots/{d}   { allow read: if isOps();    allow write: if false; }
    match /system_health/{d}         { allow read: if true;       allow write: if false; }

    // =============================================
    // INTERNAL QUEUES — DENY ALL CLIENT ACCESS
    // Only accessed by Cloud Functions via Admin SDK.
    // =============================================
    match /disbursement_queue/{d}    { allow read, write: if false; }
    match /notification_queue/{d}    { allow read, write: if false; }
    match /metamap_shadow_log/{d}    { allow read, write: if false; }

    // =============================================
    // DENY ALL OTHER PATHS
    // Explicit catch-all to prevent accidental access.
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
