rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin') || (isAuthenticated() && request.auth.token.admin == true);
    }
    function isOps() {
      return hasRole('ops') || isAdmin();
    }
    // An employer_admin's uid is the employer doc id; the employerId claim is
    // a fallback for the case where the two diverge (set by setClaims CF).
    function isEmployerAdminOf(employerId) {
      return isAuthenticated() && (
        request.auth.uid == employerId ||
        request.auth.token.employerId == employerId
      );
    }
    // Only touching these fields is a no-op update — allow self-updates that don't modify them.
    function onlyAffects(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // =============================================
    // USERS COLLECTION
    // Owner or admin can read their profile. All writes via Admin SDK (setClaims CF).
    // =============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // =============================================
    // EMPLOYERS COLLECTION
    // Get: the employer's own admin or ops.
    // List: ops only (admin console). The unauthenticated employerCode lookup
    //   during onboarding goes through the lookupEmployerByCode CF, which
    //   returns only employerId + companyName. It used to be `list: if true`,
    //   which handed every employer document — apiKeyHash, rfc, bankClabe,
    //   email, mlScore, riskTier, llmAnalysis — to any anonymous caller.
    // Create: admin (any shape), or a user bootstrapping their OWN employer doc
    //   during onboarding. Self-created docs are pinned to
    //   'pending_verification' and may not carry privileged fields: status is
    //   what onEmployerDocCreated keys the employer_admin claim off, so letting
    //   the client choose it would be self-service privilege escalation.
    // Update: admin (any field), or own admin (whitelisted contact fields only).
    // Delete: ops only.
    // =============================================
    function isSelfServeEmployerCreate() {
      // ADR-007: the lending-slot ledger is Admin-SDK-only. `maxActiveSlots`
      // was already blocked, but the fields that FEED it were not — a
      // self-serve employer that created itself with `tier: 1` and
      // `cleanPayrollCyclesSinceReview: 2` would hand its first
      // due-diligence review a pre-loaded accrual and walk straight into a
      // credited increment. Blocking the cap while leaving its inputs
      // writable is not a cap.
      //
      // `employerCode` is blocked for a different reason: it is a NAMESPACE,
      // not a property of this document. It was generated in the browser
      // (Onboarding.tsx's generateEmployerCode) and written straight here, so
      // the namespace was first-come-first-served to anyone with an email
      // address — and the code is not a secret, it is printed on the
      // employer's own roster screen and handed to every employee they
      // onboard. An attacker could self-register an "employer" carrying a code
      // a real company was already using. lookupEmployerByCode resolves it
      // with .where(...).limit(1), and an unordered Firestore query is ordered
      // by document id, so of the two documents now holding that code the
      // lower uid wins — and the attacker can re-register until theirs does.
      // Every employee who then typed that company's code wrote
      // `employerId: <attacker uid>` onto their own employees/{uid} document,
      // and the read rule below grants isEmployerAdminOf(employerId) on it: no
      // role claim needed, just a uid match. Full name, CURP, RFC, date of
      // birth, phone, bank CLABE and salary for the whole cohort, plus their
      // loans via getEmployerDashboard.
      //
      // onEmployerDocCreated is now the single writer of this field, minting
      // and reserving it in one transaction against both registries.
      return request.resource.data.status == 'pending_verification'
             && !request.resource.data.keys().hasAny([
                  'apiKeyHash', 'creditLimit', 'riskTier', 'mlScore', 'llmAnalysis',
                  'approvedAt', 'approvedBy', 'currentOutstandingBalance', 'maxActiveSlots',
                  'maxActiveSlotsSource', 'tier', 'cleanPayrollCycles',
                  'cleanPayrollCyclesSinceReview', 'employerScore', 'dueDiligenceResult',
                  'employerCode'
                ]);
    }

    match /employers/{employerId} {
      allow get: if isEmployerAdminOf(employerId) || isOps();
      allow list: if isOps();
      allow create: if isAdmin()
                    || (isOwner(employerId) && isSelfServeEmployerCreate());
      allow update: if isAdmin()
                    || (isEmployerAdminOf(employerId)
                        && onlyAffects(['contactName', 'contactEmail', 'contactPhone', 'logoUrl', 'updatedAt']));
      // Same reasoning as /loans: an employer document anchors its employees'
      // loans. Deleting it directly orphans them and leaves no audit record.
      // Offboarding is a status change, not a delete. (#385)
      allow delete: if false;
    }

    // =============================================
    // EMPLOYEES COLLECTION (flat /employees/{uid})
    // Read: the employee themselves, the employer_admin of their employer, or ops.
    //   This is the core isolation: employee A cannot read employee B even in
    //   the same employer, and employer A cannot read employer B's employees.
    // Create: self-registration during onboarding (uid == employeeId), but the
    //   credit line may not be self-assigned. creditLimit/availableCredit are
    //   derived from monthlySalary by onEmployeeDocCreated; before this
    //   constraint the client wrote both directly (Onboarding.tsx), so a user
    //   could pick their own borrowing ceiling at registration. The named
    //   employer must also exist, be in a status this codebase already treats
    //   as eligible, and (if that employer opted into a CURP allowlist) admit
    //   this CURP — see employeeCreateEligibleEmployer below.
    //   The identity verdict may not be self-assigned either — see
    //   noSelfAssignedVerification below.
    // Update: ops (any field), or self (whitelisted personal fields only) —
    //   creditLimit, availableCredit, employerId and the verification fields
    //   are absent from that whitelist, so they can only come from CFs.
    // Delete: ops only.
    // =============================================
    function noSelfAssignedCredit() {
      return !request.resource.data.keys().hasAny([
        'creditLimit', 'availableCredit', 'creditLimitSetAt', 'salarySource', 'riskTier', 'mlScore'
      ]);
    }

    // The identity verdict, made server-owned.
    //
    // The comment above has said "kycStatus must come from CFs" since this
    // block was written, and nothing ever implemented it: noSelfAssignedCredit
    // names the six credit fields and stops. `allow update` was never the hole
    // — a self-update is confined to onlyAffects([phone, bankClabe, ...]),
    // which lists none of these fields. CREATE was the hole, and it is the
    // write that matters, because employees/{uid} is created ONCE, by the
    // browser, with whatever payload the browser chose. A signup could carry
    // kycStatus: 'approved' and nothing looked at it again.
    //
    // Two different treatments, because these fields are not the same kind of
    // thing:
    //
    //   metamapStatus / metamapVerifiedAt / metamapLastEventAt are MetaMap's
    //   verdict, written only by handleVerificationCompleted (functions/src/
    //   webhooks/metamap.ts) behind an HMAC signature check, and read by
    //   requestLoan as the sole proof of identity (IDENTITY_NOT_VERIFIED).
    //   That handler uses the Admin SDK, which does not evaluate these rules
    //   at all, so blocking the fields here costs the verification path
    //   nothing and takes the client out of it completely. Without this, the
    //   server-side gate would be decorative: a borrower refused for
    //   metamapStatus could simply write metamapStatus: 'verified' onto their
    //   own document at signup.
    //
    //   metamapVerificationId is deliberately NOT blocked. Onboarding.tsx
    //   writes it as the key handleVerificationCompleted matches the incoming
    //   webhook against, so the client must be able to set it, and on its own
    //   it asserts nothing — it names a verification, it does not claim one
    //   passed.
    //
    //   kycStatus is a display field (KYCBanner, EmployeeRoster's KycBadge)
    //   that onboarding legitimately writes, so it is constrained by VALUE
    //   rather than blocked outright: the client may say "not started",
    //   "waiting" or "rejected" about itself, never "approved"/"verified".
    //   Nothing with money behind it reads this field any more.
    function noSelfAssignedVerification() {
      return !request.resource.data.keys().hasAny([
               'metamapStatus', 'metamapVerifiedAt', 'metamapLastEventAt'
             ])
          && (!('kycStatus' in request.resource.data)
              || request.resource.data.kycStatus in ['not_started', 'pending_review', 'rejected']);
    }

    // employees/{uid}.employerId is client-chosen and, until this rule,
    // nothing ever cross-checked it — anyone who knew (or guessed) an
    // employer's join code could enrol under that employer with a
    // self-declared salary. PR #566 closed the money-side half of this
    // (requestLoan now enforces curpConfig at loan time); this is the
    // write-side half, since every other consumer of /employees — employer
    // dashboards, ops tooling, exports — reads a document that was never
    // verified at the point it was created.
    //
    // A rules gate only binds writes made from today forward: every
    // enrolment already sitting in /employees is untouched by this, and nothing
    // here attempts to detect or clean those up.
    //
    // What this CAN verify, with one extra document read:
    //   - the named employer actually exists;
    //   - it is in a status this codebase already treats as eligible to take
    //     on employees — the same 'active' / 'pending_verification' pair
    //     requestLoan's own employer gate accepts (functions/src/index.ts,
    //     the EMPLOYER_NOT_APPROVED check) — so an employer mid-self-serve-
    //     onboarding is not locked out, but a rejected/suspended one is;
    //   - when that employer has turned on a CURP allowlist
    //     (curpConfig.mode == 'allowlist', set via updateEmployerCurpConfig),
    //     the registering CURP's prefix is one that employer actually listed.
    //
    // What this CANNOT verify: an employer that has never turned the
    // allowlist on — curpConfig absent, or mode: 'open', true for most of the
    // existing book today — has no per-employee membership signal in
    // Firestore at all, so anyone who knows that employer's join code can
    // still self-enrol under it. Rules cannot call out to payroll or any
    // other system of record to confirm real employment; closing that
    // remaining gap requires the employer to turn curpConfig on, which is a
    // product decision this file cannot make for them.
    function employeeCreateEligibleEmployer(employerId, curp) {
      return employerId is string
          && employerAcceptsEnrolment(
               get(/databases/$(database)/documents/employers/$(employerId)).data, curp);
    }
    function employerAcceptsEnrolment(employer, curp) {
      return (employer.status == 'active' || employer.status == 'pending_verification')
          && curpAllowedByEmployer(employer, curp);
    }
    // Absent curpConfig, or an explicit mode: 'open', means the employer never
    // restricted who may enrol under it — mirrors the same fallback
    // updateEmployerCurpConfig itself applies (any mode other than
    // 'allowlist' resolves to 'open').
    //
    // The stored prefix list is NOT trusted to be well-formed. Two reasons:
    //   - updateEmployerCurpConfig only started rejecting an allowlist with no
    //     usable prefixes in #566, so documents saved while curpConfig was
    //     inert can still carry an empty or junk list;
    //   - even today it filters on length == 4 alone, so a four-character
    //     string of regex metacharacters ('.*ab', '[[[[') survives it, and
    //     this file interpolates that list straight into a match pattern.
    //
    // So the list is enforced only when it is EXACTLY a '|'-joined run of
    // 4-character alphanumeric prefixes; anything else is treated as
    // unconfigured. That gives, in one test:
    //   - regex safety — a metacharacter can never reach the pattern, whether
    //     it widens the alternation or breaks it into an evaluation error that
    //     would lock the employer's own new hires out;
    //   - agreement with requestLoan (index.ts, assertBorrowerAdmittedByEmployer),
    //     which treats "no usable prefixes" as OPEN and says so in the log.
    //     Denying here where the money gate admits would take an employer's new
    //     hires off the product on the enforcing deploy, silently, for a
    //     malformed setting they were never shown the meaning of — the exact
    //     outcome #566 declined to ship.
    // Where the two still differ ('GARJ' alongside a junk entry: requestLoan
    // enforces the survivor, this treats the config as open) the divergence
    // falls open at REGISTRATION only. The loan itself is still gated, so a
    // borrower this admits is one requestLoan can and does still refuse.
    function curpAllowedByEmployer(employer, curp) {
      return !('curpConfig' in employer)
          || employer.curpConfig.mode != 'allowlist'
          || !curpPrefixListIsEnforceable(employer.curpConfig.prefixes)
          || (curp is string
              && curp.upper().matches('^(' + employer.curpConfig.prefixes.join('|') + ').*'));
    }
    function curpPrefixListIsEnforceable(prefixes) {
      return prefixes is list
          && prefixes.size() > 0
          && prefixes.join('|').matches('^[A-Za-z0-9]{4}([|][A-Za-z0-9]{4})*$');
    }

    match /employees/{employeeId} {
      allow read: if isOwner(employeeId)
                  || (resource != null && isEmployerAdminOf(resource.data.employerId))
                  || isOps();
      allow create: if isOwner(employeeId)
                    && noSelfAssignedCredit()
                    && noSelfAssignedVerification()
                    && employeeCreateEligibleEmployer(request.resource.data.employerId, request.resource.data.curp);
      allow update: if isOps()
                    || (isOwner(employeeId)
                        && onlyAffects(['phone', 'bankClabe', 'bankName', 'address',
                                        'dateOfBirth', 'gender', 'updatedAt']));
      // Same reasoning as /loans and /employers (#385): an employee document is
      // what a loan's employeeId points at. Deleting it from a client SDK
      // orphans every loan that references it, destroys the creditLimit/riskTier
      // those loans were underwritten against, and leaves no audit entry — only
      // the Admin SDK path writes audit_log. Offboarding is a status change, not
      // a delete. Verified before tightening: `deleteDoc` appears nowhere in
      // public-v2/src, so no client flow regresses.
      allow delete: if false;
    }

    // =============================================
    // EMPLOYEES SUBCOLLECTION (/employers/{employerId}/employees/{employeeDocId})
    // Used by the invite flow (sendEmployeeInvite CF). All writes via Admin SDK.
    // Read: the employer_admin of that employer, or ops.
    // =============================================
    match /employers/{employerId}/employees/{employeeDocId} {
      allow read: if isEmployerAdminOf(employerId) || isOps();
      allow write: if false;
    }

    // =============================================
    // LOANS COLLECTION
    // Read: the loan's employee, its employer_admin, or ops.
    // All writes via Admin SDK (requestLoan / markLoanDisbursed / etc.).
    // =============================================
    match /loans/{loanId} {
      allow read: if resource != null && (
                    isOwner(resource.data.employeeId) ||
                    isEmployerAdminOf(resource.data.employerId) ||
                    isOps()
                  );
      allow create, update: if false;
      // A loan is the record of a credit obligation. Deleting one destroys the
      // audit trail irreversibly and bypasses every Cloud Function path, so no
      // client — ops included — may do it directly. This block already claimed
      // "all writes via Admin SDK" while permitting ops deletes; the rule had
      // drifted from its own contract. Corrections go through an audited
      // status transition, never a delete. (#385)
      allow delete: if false;

      // Stage 3 auto-approve condition breakdown (E5c): the applicant's actual
      // bureau score, LTI, RiskSeal fraud score, ML default probability, etc,
      // each alongside the exact bound it was tested against. This is a
      // subcollection rather than a field on the loan doc above SPECIFICALLY
      // so it does not inherit that doc's `isOwner`/`isEmployerAdminOf` read
      // access — the borrower and the employer admin must not be able to read
      // their own regulated bureau data or the internal fraud/model scores and
      // thresholds off a plain client read. Ops-only, same pattern as
      // `audit_log` below. Written only via the Admin SDK, in the same
      // transaction as the loan document.
      match /underwritingDetail/{docId} {
        allow read: if isOps();
        allow write: if false;
      }
    }

    // =============================================
    // INVITES COLLECTION (VID3-672)
    // All access via Admin SDK: sendEmployeeInvite / lookupInvite / acceptInvite CFs.
    // The lookupInvite CF accepts the raw token and hashes it server-side,
    // so clients never need to read these documents directly.
    // =============================================
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // =============================================
    // WEBHOOK EVENTS (VID3-657) — MetaMap webhook handler
    // Admin SDK only — written by the webhook Cloud Function, read by ops via CF.
    // =============================================
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    // =============================================
    // CONTACT — PUBLIC SUBMIT (validated), ADMIN READ/MANAGE
    // Public marketing forms (coming-soon page + /contact) write here directly.
    // Validation keeps create open but bounds the shape to curb spam/abuse.
    // =============================================
    match /contact/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'type', 'message', 'company', 'phone', 'source', 'lang', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 3
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000
                    && request.resource.data.type is string
                    && request.resource.data.type.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // =============================================
    // REPAYMENTS — EMPLOYEE + ADMIN READ, IMMUTABLE
    // =============================================
    match /repayments/{d} {
      allow read: if isAdmin()
                  || (resource != null && isOwner(resource.data.employeeId));
      allow write: if false;
    }

    // =============================================
    // REVIEW QUEUE — OPS-ONLY READ, WRITES VIA CLOUD FUNCTIONS
    // =============================================
    match /review_queue/{docId} {
      allow read: if isOps();
      allow write: if false;
    }

    // =============================================
    // AUDIT & OPERATIONAL LOGS — OPS/ADMIN-ONLY READ, IMMUTABLE
    // All writes go through Cloud Functions (Admin SDK).
    // =============================================
    match /audit_log/{docId}         { allow read: if isOps();    allow write: if false; }
    // Legacy collection, no writer remains (everything is consolidated onto
    // audit_log). Records written before the consolidation still live here and
    // are the only copy of that role grant/revoke history, so ops keeps read.
    match /auditLogs/{docId}         { allow read: if isOps();    allow write: if false; }
    match /overdue_log/{d}           { allow read: if isAdmin();  allow write: if false; }
    match /spei_log/{d}              { allow read: if isAdmin();  allow write: if false; }
    match /payment_failures/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /incident_log/{d}          { allow read: if isAdmin();  allow write: if false; }
    match /notification_log/{d}      { allow read: if isAdmin();  allow write: if false; }
    match /softcredito_employers/{d} { allow read: if isAdmin();  allow write: if false; }
    match /ml_decisions/{d}          { allow read: if isOps();    allow write: if false; }

    // =============================================
    // OPS-READABLE OPERATIONAL COLLECTIONS
    // =============================================
    match /scheduler_runs/{d}        { allow read: if isOps();    allow write: if false; }
    match /portfolio_snapshots/{d}   { allow read: if isOps();    allow write: if false; }
    // Was `if true` — readable by anyone on the internet with the project id and
    // no account at all. systemHealthCheck writes the live up/down state and
    // latency of the payment server and the ML underwriting service into
    // system_health/current, and on a failed probe it writes the raw fetch error,
    // which carries the internal hostname it could not reach; queueHealthCheck
    // writes per-queue failure counts into system_health/queues. That is an
    // anonymous, real-time feed of which money-moving dependency is down right
    // now, and what it is called internally.
    // No client needs it: public-v2 reads health through the ops-only
    // getSystemHealth callable and the aggregate on getAdminDashboard, both of
    // which use the Admin SDK and bypass these rules. The only direct client
    // reads are on the legacy public/ console, which firebase.json does not
    // serve (hosting publishes public-v2/dist) and whose health screens are
    // admin-only anyway, so they satisfy isOps() too.
    match /system_health/{d}         { allow read: if isOps();    allow write: if false; }

    // =============================================
    // PLATFORM CONFIG (#389) — NO CLIENT ACCESS AT ALL
    // config/loan holds the live loan fee rate; config/loan/proposals/* holds
    // pending two-person change proposals. Both are reachable ONLY through the
    // Admin SDK (getLoanConfigValues, proposeLoanConfigChange,
    // approveLoanConfigChange), which bypasses these rules.
    //
    // Deny is spelled out rather than left to the catch-all at the bottom of
    // this file. The fall-through gives the same answer today, but this is the
    // document that prices every loan: the day someone adds a broader match
    // above the catch-all, the difference between an explicit deny and an
    // absent rule is the difference between a config read failing and a client
    // rewriting the fee rate. Read is denied too — the borrower-facing rate
    // comes from the getLoanConfig callable, so no client has any reason to
    // read this path, and denying it keeps pending pricing proposals private.
    // {document=**} so the proposals subcollection is covered, not just the
    // top-level documents.
    // =============================================
    match /config/{document=**} {
      allow read, write: if false;
    }

    // =============================================
    // INTERNAL QUEUES — DENY ALL CLIENT ACCESS
    // Only accessed by Cloud Functions via Admin SDK.
    // =============================================
    match /disbursement_queue/{d}    { allow read, write: if false; }
    match /notification_queue/{d}    { allow read, write: if false; }
    match /metamap_shadow_log/{d}    { allow read, write: if false; }

    // =============================================
    // DENY ALL OTHER PATHS
    // =============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
