NODE_ENV=staging
PORT=3004
REDIS_URL=${{Redis.REDIS_URL}}
FIREBASE_PROJECT_ID=vida-finance-staging
FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded service account JSON>
FIREBASE_STORAGE_BUCKET=vida-finance-staging.appspot.com
INTERNAL_SECRET=<shared secret for inter-service auth>
PDF_STORAGE_PATH=documents/
MAX_CONCURRENT_PDF_JOBS=3
SOFOM_RFC=VIDA240101XXX
SOFOM_ADDRESS=Paseo de la Reforma 250 Piso 12, CDMX
MIFIEL_APP_ID=<from Railway secret>
MIFIEL_APP_SECRET=<from Railway secret>
MIFIEL_ENV=sandbox

# Alerting (Sprint 3)
SLACK_WEBHOOK_URL=<from Slack app config for #vida-alerts>
PAGERDUTY_ROUTING_KEY=<from PagerDuty service integration>
