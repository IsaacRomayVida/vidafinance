NODE_ENV=staging
PORT=3004
REDIS_URL=${{Redis.REDIS_URL}}
FIREBASE_PROJECT_ID=vida-finance-staging
FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded service account JSON>
FIREBASE_STORAGE_BUCKET=vida-finance-staging.appspot.com
INTERNAL_SECRET=<shared secret for inter-service auth>
PDF_STORAGE_PATH=documents/
MAX_CONCURRENT_PDF_JOBS=3
SOFOM_RFC=VIDA240101XXX
SOFOM_ADDRESS=Paseo de la Reforma 250 Piso 12, CDMX
MIFIEL_APP_ID=<from Railway secret>
MIFIEL_APP_SECRET=<from Railway secret>
MIFIEL_ENV=sandbox

# Alerting (Slack + PagerDuty)
SLACK_WEBHOOK_URL=<Slack incoming webhook URL for #vida-alerts>
PAGERDUTY_ROUTING_KEY=<PagerDuty Events API v2 routing key>
# Alerting (Sprint 3)

# Mifiel e-signature (VID3-626)
# Sandbox: app-sandbox.mifiel.com — SDK accepts either access token OR app_id + app_secret pair
# Production: requires completed KYB with Mifiel (SOFOM RFC) — do NOT enable until approved
MIFIEL_ENABLED=false
MIFIEL_ENV=sandbox
MIFIEL_APP_ID=
MIFIEL_APP_SECRET=
# MIFIEL_ACCESS_TOKEN=  (optional alternative to APP_SECRET)
API_BASE_URL=https://pdf-generator-production-1a31.up.railway.app
