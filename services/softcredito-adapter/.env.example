NODE_ENV=staging
PORT=3002
REDIS_URL=redis://vida-redis.railway.internal:6379
REDIS_CACHE_TTL=86400
SOFTCREDITO_API_URL=https://ws.softcredito.com.mx/api
SOFTCREDITO_USER=
SOFTCREDITO_PASSWORD=
SOFTCREDITO_CERTIFICATE=
SOFTCREDITO_CLIENT_ID=<from Railway secret>
SOFTCREDITO_CLIENT_SECRET=<from Railway secret>
RENAPO_API_URL=https://sesna.gob.mx/api/v1
FIREBASE_PROJECT_ID=vida-finance-staging
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded service account JSON>
INTERNAL_SECRET=<shared secret for inter-service auth>
INTERNAL_API_SECRET=
PAYMENT_SERVER_URL=http://payment-server.railway.internal:3001

# Alerting
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
