NODE_ENV=staging
PORT=3002
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_CACHE_TTL=86400
FIREBASE_PROJECT_ID=vida-finance-staging
FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded service account JSON>
INTERNAL_SECRET=<shared secret for inter-service auth>
SOFTCREDITO_API_URL=https://api.softcredito.com.mx/v1
SOFTCREDITO_CLIENT_ID=<from Railway secret>
SOFTCREDITO_CLIENT_SECRET=<from Railway secret>
PAYMENT_SERVER_URL=http://vida-payment-server.railway.internal:3001
