# ── Conekta ────────────────────────────────────────────────────────────────────
CONEKTA_API_KEY=<conekta-private-key-key_xxx>
CONEKTA_WEBHOOK_SECRET=<conekta-webhook-hmac-or-public-key>

# ── Internal Auth ──────────────────────────────────────────────────────────────
# Shared secret for /internal/* and /payment-links/* routes
INTERNAL_API_SECRET=<generate-with-openssl-rand-hex-32>

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://vida-finance.web.app,https://employer.vida.finance
