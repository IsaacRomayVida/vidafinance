# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── Redis (Railway) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Firebase ───────────────────────────────────────────────────────────────────
# Base64-encoded service account JSON: base64 < serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=<base64-encoded-service-account-json>
# OR set the raw JSON string directly (alternative to B64):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

FIREBASE_PROJECT_ID=vida-staging

# Firebase Cloud Functions base URL (used to call markLoanDisbursed)
FIREBASE_FUNCTIONS_URL=https://us-central1-vida-staging.cloudfunctions.net

# ── STP SPEI (Sandbox) ─────────────────────────────────────────────────────────
STP_API_URL=https://demo.stpmex.com:7002
STP_EMPRESA=VIDA SOFOM
STP_API_KEY=<stp-sandbox-api-key>

