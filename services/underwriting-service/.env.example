PORT=3003
FIREBASE_SERVICE_ACCOUNT=
INTERNAL_SECRET=
REDIS_URL=

# Free government APIs (no auth)
SAT_SOAP_CFDI_URL=https://consultaqr.facturaelectronica.sat.gob.mx/ConsultaCFDIService.svc
DENUE_API_URL=https://api.datos.gob.mx/v2/inegi.denue.df_denue
REPSE_URL=https://repse.stps.gob.mx/app/api/consultaRegistroRepse
SEP_CEDULAS_URL=https://cedulaprofesional.sep.gob.mx/cedula/presidencia/indexAvanzada.action
REPUVE_URL=https://www.repuve.gob.mx:8443/ciudadanoInternet/consultas/ConsultaVehiculo
CONDUSEF_URL=https://phpapps.condusef.gob.mx/condusefcloud/index.php
IP_API_URL=http://ip-api.com/json
CNBV_DATA_URL=https://portafoliodeinformacion.cnbv.gob.mx

# Verifik (paid — sign up at https://verifik.co/en/register)
VERIFIK_API_KEY=
VERIFIK_BASE_URL=https://api.verifik.co

# SW SAPiens (sw.com.mx — rotating JWT, store credentials not token)
SW_USER=
SW_PASSWORD=
SW_BASE_URL=https://services.sw.com.mx

# Belvo open-finance (sign up at https://dashboard.belvo.com/register)
# Sandbox: immediate access. Production: 3–7 business days.
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_BASE_URL=https://sandbox.belvo.com

# RiskSeal digital footprint (contract-only — contact hello@riskseal.io)
# Set RISKSEAL_MOCK=true until contract arrives; swap to false + real key after.
RISKSEAL_MOCK=true
RISKSEAL_API_KEY=PENDING_CONTRACT
RISKSEAL_BASE_URL=https://api.riskseal.io/v1

# Google Document AI — payroll slip OCR
# Reuses FIREBASE_SERVICE_ACCOUNT credentials by default.
# Set GOOGLE_DOCAI_CREDENTIALS only if using a separate SA.
GOOGLE_DOCAI_PROJECT_ID=vida-finance
GOOGLE_DOCAI_LOCATION=us
GOOGLE_DOCAI_PROCESSOR_ID=8d46c79a75eb5406
# GOOGLE_DOCAI_CREDENTIALS=  (optional — falls back to FIREBASE_SERVICE_ACCOUNT)

# MetaMap KYC & AML (sign up at https://metamap.com)
# METAMAP_MOCK=true for development without credentials
METAMAP_MOCK=true
METAMAP_CLIENT_ID=
METAMAP_CLIENT_SECRET=
METAMAP_BASE_URL=https://api.metamap.com
METAMAP_FLOW_ID_KYC=
METAMAP_FLOW_ID_AML=
METAMAP_FLOW_ID_BEHAVIORAL=
METAMAP_WEBHOOK_SECRET=

# MetaMap KYC mode (VID3-641)
# real       — (default) full MetaMap biometric flow, user must complete in app
# mock_pass  — skip MetaMap, return verified result (for headless E2E tests)
# mock_fail  — skip MetaMap, return rejected result (for testing rejection path)
# WARNING: never set to mock_pass/mock_fail in production!
KYC_MODE=real

# ML Service (internal)
ML_SERVICE_URL=http://localhost:3005
ML_INTERNAL_SECRET=

# SoftCredito Adapter (internal)
SOFTCREDITO_ADAPTER_URL=http://localhost:3004

# Fallback: Signzy (if Verifik production approval delayed)
# SIGNZY_API_KEY=

# Alerting (Slack + PagerDuty)
SLACK_WEBHOOK_URL=<Slack incoming webhook URL for #vida-alerts>
PAGERDUTY_ROUTING_KEY=<PagerDuty Events API v2 routing key>
# Alerting (Sprint 3)
