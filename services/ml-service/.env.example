NODE_ENV=staging
PORT=3005
REDIS_URL=${{Redis.REDIS_URL}}
FIREBASE_PROJECT_ID=vida-finance-staging
FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded service account JSON>
INTERNAL_SECRET=<shared secret for inter-service auth>
ANTHROPIC_API_KEY=<from Railway secret>
MODEL_PATH=models/underwriting_v1.joblib
USE_ML_MODELS=false
ML_CACHE_TTL=86400

# Firebase Admin SDK credentials (one of the two must be set)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=

# Underwriting worker tuning
MODEL_PATH=models/underwriting_v1.joblib
APPROVAL_THRESHOLD=0.65
CHAMPION_MODEL_PATH=models/scorecard_champion_v2.joblib
CHALLENGER_MODEL_PATH=models/xgb_challenger_v2.joblib
ISOLATION_FOREST_PATH=models/isolation_forest_v1.joblib
ACTIVE_LEARNER_PATH=models/active_learner_v1.joblib
AUTOENCODER_MODEL_PATH=models/autoencoder_v2_metamap.pt

# Thin-file k-NN (OpenAI embeddings + FAISS)
OPENAI_API_KEY=<from Railway secret>

# Softcredito adapter URL (Railway internal network)
SOFTCREDITO_ADAPTER_URL=http://vida-softcredito.railway.internal:3004

# Decision engine service URL (Railway internal network)
DECISION_ENGINE_URL=http://vida-underwriting.railway.internal:3003
DECISION_ENGINE_TIMEOUT=30

# Alerting (Slack + PagerDuty)
SLACK_WEBHOOK_URL=<Slack incoming webhook URL for #vida-alerts>
PAGERDUTY_ROUTING_KEY=<PagerDuty Events API v2 routing key>
# Alerting (Sprint 3)
