NODE_ENV=staging
PORT=3005
REDIS_URL=${{Redis.REDIS_URL}}
FIREBASE_PROJECT_ID=vida-finance-staging
FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded service account JSON>
INTERNAL_SECRET=<shared secret for inter-service auth>
ANTHROPIC_API_KEY=<from Railway secret>
MODEL_PATH=models/underwriting_v1.joblib
USE_ML_MODELS=false
ML_CACHE_TTL=86400

# Firebase Admin SDK credentials (one of the two must be set)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_B64=

# Underwriting worker tuning
MODEL_PATH=models/underwriting_v1.joblib
APPROVAL_THRESHOLD=0.65

# Softcredito adapter URL (Railway internal network)
SOFTCREDITO_ADAPTER_URL=http://vida-softcredito.railway.internal:3004
