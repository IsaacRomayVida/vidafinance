{
  "expo": {
    "name": "FunPay",
    "slug": "funpay",
    "owner": "vidateam",
    "extra": {
      "eas": {
        "projectId": "a882e7fb-24bb-4363-9337-5e37825ade91"
      }
    },
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "funpay",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f9f7",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#eaf5f1"
    },
    "android": {
      "package": "mx.funpay.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#194445"
      },
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "mx.funpay.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FunPay usa tu galería para subir tu identificación durante la verificación."
      }
    },
    "plugins": [
      "react-native-metamap-sdk/plugin/build/index.js",
      "expo-video"
    ]
  }
}