rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---- helpers ----
    function isAuth() {
      return request.auth != null;
    }
    function isOps() {
      return isAuth() && (
        request.auth.token.role == 'ops' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }
    function isEmployerAdminOf(employerId) {
      return isAuth()
        && request.auth.token.role == 'employer_admin'
        && request.auth.token.employerId == employerId;
    }
    function sizeUnder(limit) {
      return request.resource.size < limit;
    }
    function contentTypeIn(pattern) {
      return request.resource.contentType.matches(pattern);
    }
    function isCreate() {
      return resource == null;
    }
    function loanDoc(loanId) {
      return firestore.get(/databases/(default)/documents/loans/$(loanId)).data;
    }

    // ---- 1. Employer signup docs — CLOSED ----
    //
    // This was `allow write: if sessionId.size() >= 20 && sizeUnder(10MB) &&
    // contentTypeIn(...)`, and that condition never mentions request.auth. Storage
    // rules are evaluated with request.auth == null for an anonymous caller, so
    // the rule passed for one: anybody on the internet who knew the bucket name —
    // which ships in the web bundle — could POST unlimited 10 MB PDFs and images
    // into this project's Storage bucket with no account, no App Check (Storage
    // does not enforce it unless it is turned on, and nothing here turns it on)
    // and no rate limit. They picked the sessionId themselves, so the ">= 20 chars
    // of entropy" the old comment relied on was entropy the ATTACKER chose; it
    // stops a stranger guessing someone else's session, not a stranger opening
    // their own. That is storage and egress billed to VIDA without limit, and
    // attacker-controlled files served from a firebasestorage.googleapis.com URL
    // for this project — which ops then opens from the console, because `read` on
    // this path is granted to isOps() and the files look like employer KYC
    // documents.
    //
    // Closed rather than tightened to isAuth(), because there is no pre-auth
    // upload flow to preserve: this path is referenced NOWHERE in the repository
    // outside this rule (verified across public-v2/, public/, services/, scripts/
    // and tests/). The employer signup wizard creates the Firebase Auth user
    // FIRST and then uploads (public-v2/src/pages/Onboarding.tsx —
    // createUserWithEmailAndPassword, then employers/{uid}/docs/...), and the
    // dashboard's later re-upload goes to onboarding/employer_docs/{uid}/, which
    // rule 1b below already binds to the caller's own uid. So no client loses an
    // upload it makes today.
    //
    // `read` stays with ops for whatever was deposited here while the rule was
    // open — evidence of the abuse has to remain reachable by the people who
    // would clean it up.
    match /onboarding/employer_signup/{sessionId}/{fileName} {
      allow write: if false;
      allow read: if isOps();
    }

    // ---- 1b. Legacy onboarding path (migration window) ----
    // EmployerDashboard.tsx still writes to onboarding/employer_docs/{uid}/...
    // after auth. Tighten to authenticated owner only until clients migrate.
    match /onboarding/employer_docs/{uid}/{fileName} {
      allow write: if isAuth()
                   && request.auth.uid == uid
                   && sizeUnder(10 * 1024 * 1024)
                   && contentTypeIn('application/pdf|image/.*');
      allow read: if isAuth() && (request.auth.uid == uid || isOps());
    }

    // ---- 2. Employer post-signup docs ----
    match /employers/{employerId}/docs/{fileName} {
      allow read: if isEmployerAdminOf(employerId) || isOps();
      allow write: if isEmployerAdminOf(employerId)
                   && isCreate()
                   && sizeUnder(10 * 1024 * 1024)
                   && contentTypeIn('application/pdf|image/.*');
    }

    // ---- 3. Signed loan contracts ----
    // Writes are performed by the pdf-generator service (Admin SDK, bypasses rules).
    // Forward-looking path: contracts/{loanId}.pdf
    match /contracts/{fileName} {
      allow read: if isAuth() && (
        request.auth.uid == firestore.get(
          /databases/(default)/documents/loans/$(fileName.split('\\.')[0])
        ).data.employeeUid ||
        request.auth.uid == firestore.get(
          /databases/(default)/documents/loans/$(fileName.split('\\.')[0])
        ).data.employerAdminUid ||
        isOps()
      );
      allow write: if false;
    }
    // Legacy path currently used by pdf-generator: loans/{loanId}/{file}
    match /loans/{loanId}/{file} {
      allow read: if isAuth() && (
        request.auth.uid == loanDoc(loanId).employeeUid ||
        request.auth.uid == loanDoc(loanId).employerAdminUid ||
        isOps()
      );
      allow write: if false;
    }

    // ---- 4. KYC identity documents ----
    match /kyc/{employeeUid}/{fileName} {
      allow read: if isAuth() && (request.auth.uid == employeeUid || isOps());
      allow write: if isAuth()
                   && request.auth.uid == employeeUid
                   && isCreate()
                   && sizeUnder(20 * 1024 * 1024)
                   && contentTypeIn('image/.*|application/pdf');
    }

    // ---- 5. Payroll CSV uploads ----
    match /payroll/{employerId}/{yyyyMM}/{fileName} {
      allow read: if isEmployerAdminOf(employerId) || isOps();
      allow write: if isEmployerAdminOf(employerId)
                   && isCreate()
                   && sizeUnder(50 * 1024 * 1024)
                   && contentTypeIn('text/csv|application/vnd.ms-excel');
    }

    // ---- 6. Default deny ----
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
