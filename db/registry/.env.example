# Postgres connection string used by migrations (npm run migrate:up/down)
# and by the services/shared/registry/*.test.js suites.
#
# There is no universal "postgres" superuser role -- a stock Homebrew/local
# Postgres install only has a role for the current OS user. Replace
# YOUR_DB_USER below with a role that exists on your machine (often just
# your OS username, e.g. `whoami`); the test suites themselves already fall
# back to that OS user when DATABASE_URL is unset, so this file only needs
# to be filled in for the migration CLI or when your setup differs.
DATABASE_URL=postgres://YOUR_DB_USER@localhost:5432/vida_registry_test
