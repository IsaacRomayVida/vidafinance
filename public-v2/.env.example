# Firebase App Check — reCAPTCHA Enterprise (VID3-676 / VID3-677)
# Get site key from Firebase Console → App Check → vida-finance web app
# Starts with 6L...
VITE_RECAPTCHA_SITE_KEY=

# Debug token for local development only (Firebase Console → App Check → Debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=

# Sentry error telemetry (optional — Sentry is disabled when unset)
# Get DSN from https://sentry.io → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
# Optional: stamp crash reports with the deployed commit SHA
VITE_APP_VERSION=
